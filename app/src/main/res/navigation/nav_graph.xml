<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/mainFragment">

    <action
        android:id="@+id/action_global_track"
        app:destination="@id/trackFragment"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_left"
        app:popEnterAnim="@anim/slide_in_left"
        app:popExitAnim="@anim/slide_out_right" />

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.musicplayer.ui.main.MainFragment"
        android:label="@string/my_tracks">
        <action
            android:id="@+id/action_main_to_track"
            app:destination="@id/trackFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="com.example.musicplayer.ui.favorites.FavoritesFragment"
        android:label="@string/favorites">
        <action
            android:id="@+id/action_favorites_to_track"
            app:destination="@id/trackFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/trackFragment"
        android:name="com.example.musicplayer.ui.track.TrackFragment"
        android:label="@string/track_details">
        <argument
            android:name="trackId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

</navigation>
