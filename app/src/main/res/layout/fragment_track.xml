<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/section_spacing">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/control_small"
            android:layout_height="@dimen/control_small"
            android:layout_gravity="start"
            android:layout_marginTop="@dimen/item_spacing"
            android:background="@drawable/bg_control_button"
            android:contentDescription="@string/back"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_back" />

        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="@dimen/cover_large"
            android:layout_height="@dimen/cover_large"
            android:layout_marginTop="@dimen/item_spacing"
            android:background="@drawable/bg_cover_frame"
            android:contentDescription="@string/track_details"
            android:padding="@dimen/cover_large_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_album_art" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:gravity="center"
            android:text="@string/no_track"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_spacing"
            android:gravity="center"
            android:text="@string/unknown_artist"
            android:textColor="@color/on_surface_muted"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnLike"
            android:layout_width="@dimen/control"
            android:layout_height="@dimen/control"
            android:layout_marginTop="@dimen/item_spacing"
            android:background="@drawable/bg_control_button"
            android:contentDescription="@string/add_like"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:scaleType="center"
            android:src="@drawable/ic_like_outline" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPosition"
                android:layout_width="@dimen/time_label_width"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />

            <TextView
                android:id="@+id/tvDuration"
                android:layout_width="@dimen/time_label_width"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0:00"
                android:textColor="@color/on_surface_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_spacing"
            android:gravity="center"
            android:textColor="@color/error"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrevious"
                android:layout_width="@dimen/control"
                android:layout_height="@dimen/control"
                android:background="@drawable/bg_control_button"
                android:contentDescription="@string/previous"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@drawable/ic_previous" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="@dimen/control_large"
                android:layout_height="@dimen/control_large"
                android:layout_marginStart="@dimen/control_spacing"
                android:layout_marginEnd="@dimen/control_spacing"
                android:background="@drawable/bg_play_button"
                android:contentDescription="@string/play"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@drawable/ic_play"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="@dimen/control"
                android:layout_height="@dimen/control"
                android:background="@drawable/bg_control_button"
                android:contentDescription="@string/next"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@drawable/ic_next" />

            <ImageButton
                android:id="@+id/btnStop"
                android:layout_width="@dimen/control"
                android:layout_height="@dimen/control"
                android:layout_marginStart="@dimen/control_spacing"
                android:background="@drawable/bg_control_button"
                android:contentDescription="@string/stop"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:scaleType="center"
                android:src="@drawable/ic_stop" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
